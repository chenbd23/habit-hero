# Copy to .env; keep this project name stable to keep using the same data volume.
# 复制为 .env；保持项目名不变，否则会使用另一个数据卷。
COMPOSE_PROJECT_NAME=habit-hero

# Loopback by default. For trusted LAN access, use 0.0.0.0 explicitly.
# 默认仅本机可访问。可信局域网访问可改为 0.0.0.0。
HH_WEB_BIND=127.0.0.1
HH_WEB_PORT=4319

# Database path INSIDE the sync container; keep it under /data.
# 同步容器内部数据库路径，必须保存在 /data 下。
HH_DB_PATH=/data/habit-hero.sqlite

# Only used with --profile https. Replace with your own real DNS name.
# 仅 --profile https 使用；替换为你自己的真实域名。
HH_DOMAIN=habit.example.com

# Generated by scripts/setup.sh. Never reuse or publish these internal keys.
# 由 setup.sh 生成，勿复用或公开。
HH_GATEWAY_KEY=
HH_EDGE_KEY=
# invite (default): operator-created accounts or single-use family invitations.
# open: deliberately allow anyone with the URL to register.
HH_REGISTRATION=invite
HH_MAX_USERS=100
HH_MAX_FAMILIES=100
HH_ASSET_BYTES=268435456
HH_FAMILY_BYTES=335544320
HH_DB_MAX_BYTES=2147483648
HH_MIN_FREE_BYTES=268435456
